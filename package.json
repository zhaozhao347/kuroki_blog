{
  "name": "new_blog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "check:content": "node scripts/check-content.mjs",
    "check:posts": "node scripts/check-content.mjs --only=posts",
    "check:projects": "node scripts/check-content.mjs --only=projects",
    "check:pages": "node scripts/check-content.mjs --only=pages",
    "check:json": "node scripts/check-content.mjs --json",
    "check": "node scripts/check-content.mjs && npm run build && npm run budget:check",
    "check:sh": "bash scripts/check-content.sh",
    "budget": "node scripts/budget.mjs",
    "budget:json": "node scripts/budget.mjs --json",
    "budget:check": "node scripts/budget.mjs --check",
    "model:prepare": "node scripts/model-prepare.mjs",
    "new:post": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@foobar404/wave": "^2.0.5",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "lenis": "^1.3.26",
    "markdown-it": "^15.0.2",
    "motion": "^13.4.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "webgl-fluid-enhanced": "^0.8.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "js-yaml": "^5.4.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
